# Fastlane lanes for Flutter template instances (iOS).
# Run from repo root: `cd ios && bundle exec fastlane <lane>`
# Requires apply_instance_config.rb → dart_defines.prod.json + .env

default_platform(:ios)

begin
  require "dotenv"
  Dotenv.overload(File.expand_path("../../.env", __dir__))
rescue LoadError
  # fastlane embeds dotenv in normal installs; ignore if missing
end

def flutter_project_root
  File.expand_path("../..", __dir__)
end

def prod_dart_defines_file
  File.join(flutter_project_root, "dart_defines.prod.json")
end

def sync_app_icons!
  script = File.join(flutter_project_root, "scripts", "sync_app_icons.sh")
  UI.user_error!("Missing #{script}") unless File.exist?(script)

  sh("bash", script)
end

def ensure_pod_in_path!
  ruby_bin = File.dirname(`which ruby`.strip)
  ENV["PATH"] = "#{ruby_bin}:#{ENV['PATH']}" unless ruby_bin.empty?

  pod = `which pod 2>/dev/null`.strip
  return if $?.success? && !pod.empty?

  UI.message("Installing CocoaPods for #{ruby_bin}...")
  sh("gem", "install", "cocoapods", "-N")
end

def flutter_build_ipa!
  defines_file = prod_dart_defines_file
  UI.user_error!("Missing #{defines_file}") unless File.exist?(defines_file)

  sync_app_icons!
  ensure_pod_in_path!

  export_plist = if ENV["SKIP_MATCH"] == "true"
                   "ios/ExportOptions.automatic.plist"
                 else
                   "ios/ExportOptions.plist"
                 end

  Dir.chdir(flutter_project_root) do
    sh(
      "flutter", "build", "ipa",
      "--release",
      "--flavor", "prod",
      "--dart-define=APP_VARIANT=prod",
      "--dart-define-from-file=#{defines_file}",
      "--export-options-plist=#{export_plist}"
    )
  end

  ipa = Dir[File.join(flutter_project_root, "build/ios/ipa/*.ipa")].first
  UI.user_error!("IPA not found under build/ios/ipa") unless ipa
  ipa
end

def app_store_connect_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
  key_path = ENV["APP_STORE_CONNECT_API_KEY_KEY_PATH"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]

  if !key_path.to_s.empty? && File.exist?(key_path)
    key_content = File.read(key_path)
  end

  return nil if [key_id, issuer_id, key_content].any? { |v| v.to_s.strip.empty? }

  base64 = !key_content.include?("BEGIN PRIVATE KEY")
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: base64
  )
end

platform :ios do
  desc "Sync App Store signing (match)"
  lane :sync_signing do
    match(type: "appstore", readonly: false)
  end

  desc "Build prod IPA via Flutter (no upload)"
  lane :build do
    flutter_build_ipa!
  end

  desc "Upload prod build to TestFlight"
  lane :beta do
    match(type: "appstore", readonly: true) if ENV["SKIP_MATCH"] != "true"
    ipa = flutter_build_ipa!
    api_key = app_store_connect_api_key_from_env
    UI.user_error!(
      "Missing App Store Connect API key in .env — set APP_STORE_CONNECT_API_KEY_KEY_ID, " \
      "_ISSUER_ID, and _KEY (see .env.example)"
    ) unless api_key

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Submit prod build to App Store (manual review)"
  lane :release do
    match(type: "appstore", readonly: true) if ENV["SKIP_MATCH"] != "true"
    ipa = flutter_build_ipa!
    api_key = app_store_connect_api_key_from_env
    UI.user_error!(
      "Missing App Store Connect API key in .env — set APP_STORE_CONNECT_API_KEY_KEY_ID, " \
      "_ISSUER_ID, and _KEY (see .env.example)"
    ) unless api_key

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: true
    )
  end

  desc "Sync icons + build + upload TestFlight (one command)"
  lane :upload do
    beta
  end
end
