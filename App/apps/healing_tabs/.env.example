# 复制为 .env 并填入真实值（.env 已 gitignore，勿提交）
APP_IDENTIFIER=com.healingtabs.HealingTabs
APPLE_ID=your-apple-id@example.com
APPLE_TEAM_ID=XXXXXXXXXX

# App Store Connect API Key（Users and Access → Keys → App Store Connect API）
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
# 推荐：指向本机 .p8 文件（勿提交到 git）
APP_STORE_CONNECT_API_KEY_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# 或直接粘贴 .p8 全文（单行 base64 亦可）
APP_STORE_CONNECT_API_KEY_KEY=

# match 证书仓库（首次运行 fastlane match appstore）
MATCH_GIT_URL=git@github.com:YOUR_ORG/certificates.git
MATCH_PASSWORD=
MATCH_GIT_BASIC_AUTHORIZATION=

# 本机已有 Distribution 证书时可跳过 match：
# SKIP_MATCH=true
